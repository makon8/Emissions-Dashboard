{
  "datasets": [
    {
      "name": "0631889c",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,\n",
        "longitude,\n",
        "'GHT emmissions mtons CO2e' as Emissions\n",
        "from emissions.default.emissions_data"
      ]
    },
    {
      "name": "59448e2b",
      "displayName": "Emissions per person",
      "queryLines": [
        "SELECT county_state_name,\n",
        "       population,\n",
        "       CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS BIGINT) / population AS emissions_per_person\n",
        "FROM emissions.default.emissions_data\n",
        "limit 10"
      ]
    },
    {
      "name": "3f3febe6",
      "displayName": "Total Emissions Per State",
      "queryLines": [
        "SELECT state_abbr,\n",
        "       SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS double)) AS Total_Emissions\n",
        "FROM emissions.default.emissions_data\n",
        "group by state_abbr\n",
        "ORDER BY total_emissions DESC\n",
        "--limit 10"
      ]
    },
    {
      "name": "dcca7567",
      "displayName": "County Shaming",
      "queryLines": [
        "select county_state_name,\n",
        "    population,\n",
        "    cast(replace(`GHG emissions mtons CO2e`, ',', '')  AS double) AS Total_Emissions\n",
        "    FROM emissions.default.emissions_data\n",
        "    ORDER BY Total_Emissions DESC\n",
        "    LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
